<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.12"/>
  <requires lib="libadwaita" version="1.5"/>

  <template class="NetworkingLabWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Networking Lab</property>
    <property name="default-width">1100</property>
    <property name="default-height">720</property>
    <!-- HIG: 360x294 is the phone form factor apps should scale down to. -->
    <property name="width-request">360</property>
    <property name="height-request">294</property>


    <!--
      Declared here rather than through set_accels_for_action: a focused entry
      consumes plain keys first, which is exactly the suppression SPEC 8.6 asks
      for while typing.
    -->
    <child>
      <object class="GtkShortcutController">
        <property name="scope">managed</property>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">&lt;primary&gt;z</property>
            <property name="action">action(win.undo)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">&lt;primary&gt;&lt;shift&gt;z</property>
            <property name="action">action(win.redo)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">&lt;primary&gt;y</property>
            <property name="action">action(win.redo)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">&lt;primary&gt;d</property>
            <property name="action">action(win.duplicate)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">Delete</property>
            <property name="action">action(win.delete-selection)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">BackSpace</property>
            <property name="action">action(win.delete-selection)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">&lt;primary&gt;plus</property>
            <property name="action">action(win.zoom-in)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">&lt;primary&gt;equal</property>
            <property name="action">action(win.zoom-in)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">&lt;primary&gt;minus</property>
            <property name="action">action(win.zoom-out)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">&lt;primary&gt;0</property>
            <property name="action">action(win.zoom-reset)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">v</property>
            <property name="action">action(win.select-mode)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">l</property>
            <property name="action">action(win.link-mode)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">Escape</property>
            <property name="action">action(win.cancel)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">g</property>
            <property name="action">action(win.generate)</property>
          </object>
        </child>
        <child>
          <object class="GtkShortcut">
            <property name="trigger">question</property>
            <property name="action">action(win.shortcuts)</property>
          </object>
        </child>
      </object>
    </child>

    <!--
      The three columns of SPEC 8.1 are fixed-width there; here they collapse
      into overlays on a narrow window, which is what the HIG asks for. The
      setters revert when the breakpoint stops applying, so widening the window
      brings both sidebars back. The wider condition has to come first: when
      several apply, libadwaita uses the last one.
    -->
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 900sp</condition>
        <setter object="properties_split" property="collapsed">True</setter>
        <setter object="properties_split" property="show-sidebar">False</setter>
      </object>
    </child>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 700sp</condition>
        <setter object="properties_split" property="collapsed">True</setter>
        <setter object="properties_split" property="show-sidebar">False</setter>
        <setter object="palette_split" property="collapsed">True</setter>
        <setter object="palette_split" property="show-sidebar">False</setter>
        <!-- Three buttons and a percentage no longer fit beside two sidebar
             toggles. Ctrl +/-, Ctrl+0 and Ctrl+wheel still zoom. -->
        <setter object="zoom_box" property="visible">False</setter>
      </object>
    </child>

    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwToolbarView">

            <child type="top">
              <object class="AdwHeaderBar" id="header_bar">

                <child type="start">
                  <object class="GtkToggleButton" id="palette_toggle">
                    <property name="icon-name">sidebar-show-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Show Palette</property>
                  </object>
                </child>

                <child type="start">
                  <object class="GtkBox">
                    <property name="css-classes">linked</property>
                    <child>
                      <object class="GtkToggleButton" id="select_mode_button">
                        <property name="icon-name">pointer-primary-click-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Select (V)</property>
                        <property name="active">True</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkToggleButton" id="link_mode_button">
                        <property name="icon-name">insert-link-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Add Link (L)</property>
                      </object>
                    </child>
                  </object>
                </child>

                <child type="start">
                  <object class="GtkBox">
                    <property name="css-classes">linked</property>
                    <child>
                      <object class="GtkButton">
                        <property name="icon-name">edit-undo-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Undo</property>
                        <property name="action-name">win.undo</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton">
                        <property name="icon-name">edit-redo-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Redo</property>
                        <property name="action-name">win.redo</property>
                      </object>
                    </child>
                  </object>
                </child>

                <child type="end">
                  <object class="GtkMenuButton">
                    <property name="primary">True</property>
                    <property name="icon-name">open-menu-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Main Menu</property>
                    <property name="menu-model">primary_menu</property>
                  </object>
                </child>

                <child type="end">
                  <object class="GtkToggleButton" id="properties_toggle">
                    <property name="icon-name">sidebar-show-right-symbolic</property>
                    <property name="tooltip-text" translatable="yes">Show Properties</property>
                  </object>
                </child>

                <child type="end">
                  <object class="GtkBox" id="zoom_box">
                    <property name="css-classes">linked</property>
                    <child>
                      <object class="GtkButton">
                        <property name="icon-name">zoom-out-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Zoom Out</property>
                        <property name="action-name">win.zoom-out</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="zoom_reset_button">
                        <property name="tooltip-text" translatable="yes">Reset Zoom</property>
                        <property name="action-name">win.zoom-reset</property>
                        <property name="width-request">62</property>
                        <property name="label">100%</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton">
                        <property name="icon-name">zoom-in-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Zoom In</property>
                        <property name="action-name">win.zoom-in</property>
                      </object>
                    </child>
                  </object>
                </child>

                <child type="end">
                  <object class="GtkButton">
                    <property name="label" translatable="yes">_Generate</property>
                    <property name="use-underline">True</property>
                    <property name="tooltip-text" translatable="yes">Generate the compose file (G)</property>
                    <property name="action-name">win.generate</property>
                    <property name="css-classes">suggested-action</property>
                  </object>
                </child>

                <!--
                  Run/Stop. One button rather than two: the lab is either up or
                  it is not, and the label follows the state from window.vala.
                  It stays insensitive until the docker probe has answered.
                -->
                <child type="end">
                  <object class="GtkButton" id="run_button">
                    <property name="action-name">win.run-lab</property>
                    <property name="sensitive">False</property>
                    <property name="child">
                      <object class="AdwButtonContent" id="run_button_content">
                        <property name="icon-name">media-playback-start-symbolic</property>
                        <property name="label" translatable="yes">Run</property>
                      </object>
                    </property>
                  </object>
                </child>

              </object>
            </child>

            <property name="content">
              <!--
                palette | canvas | properties. The sidebars are filled from
                window.vala, so they carry no child here.
              -->
              <object class="AdwOverlaySplitView" id="palette_split">
                <!-- Pinned: the width fraction would otherwise stretch the
                     palette to the 180 default at this window size. -->
                <property name="min-sidebar-width">132</property>
                <property name="max-sidebar-width">132</property>
                <property name="content">
                  <object class="AdwOverlaySplitView" id="properties_split">
                    <property name="sidebar-position">end</property>
                    <property name="min-sidebar-width">300</property>
                    <property name="max-sidebar-width">380</property>
                    <property name="content">
                      <object class="GtkScrolledWindow" id="canvas_scroller">
                        <property name="hexpand">True</property>
                        <property name="vexpand">True</property>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>

            <!-- SPEC 8.8: one line of feedback for every action. -->
            <child type="bottom">
              <object class="GtkBox">
                <property name="css-classes">toolbar</property>
                <child>
                  <object class="GtkLabel" id="status_label">
                    <property name="xalign">0</property>
                    <property name="hexpand">True</property>
                    <property name="ellipsize">end</property>
                    <property name="css-classes">dim-label caption</property>
                  </object>
                </child>
                <!-- The lab's own state, kept apart from the action feedback
                     to its left: it persists rather than being replaced by the
                     next thing that happens (PLAN 9.2). -->
                <child>
                  <object class="GtkLabel" id="lab_status_label">
                    <property name="xalign">1</property>
                    <property name="ellipsize">end</property>
                    <property name="css-classes">dim-label caption</property>
                  </object>
                </child>
              </object>
            </child>

          </object>
        </property>
      </object>
    </property>
  </template>

  <!-- HIG: the primary menu holds app-level, not view-level, items. -->
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Import…</attribute>
        <attribute name="action">win.import</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Export…</attribute>
        <attribute name="action">win.export</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Load _Demo</attribute>
        <attribute name="action">win.load-demo</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Clear</attribute>
        <attribute name="action">win.clear</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">win.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Networking Lab</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
