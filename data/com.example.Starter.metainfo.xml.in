<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.example.Starter</id>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Starter</name>
  <summary>A Vala and GTK 4 starter application</summary>

  <description>
    <p>
      Starter is a small template application built with Vala, GTK 4, libadwaita
      and Meson. It follows the GNOME Human Interface Guidelines and is meant to
      be renamed and grown into your own application.
    </p>
    <p>It demonstrates:</p>
    <ul>
      <li>An adaptive window that stays usable at phone widths</li>
      <li>Boxed lists, toasts, a preferences dialog and an about dialog</li>
      <li>Settings and window state persisted with GSettings</li>
    </ul>
  </description>

  <developer id="com.example">
    <name>Your Name</name>
  </developer>

  <launchable type="desktop-id">com.example.Starter.desktop</launchable>

  <url type="homepage">https://example.com</url>
  <url type="bugtracker">https://example.com/issues</url>

  <screenshots>
    <screenshot type="default">
      <image>https://example.com/screenshot-1.png</image>
      <caption>The main window</caption>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.1.0" date="2026-08-08">
      <description translate="no">
        <p>Initial release.</p>
      </description>
    </release>
  </releases>
</component>
