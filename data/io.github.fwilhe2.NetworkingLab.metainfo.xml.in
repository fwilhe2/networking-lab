<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.fwilhe2.NetworkingLab</id>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>Networking Lab</name>
  <summary>A GNOME application for experimenting with networking</summary>

  <description>
    <p>
      Networking Lab is an application built with Vala, GTK 4, libadwaita and
      Meson, following the GNOME Human Interface Guidelines.
    </p>
    <p>It provides:</p>
    <ul>
      <li>An adaptive window that stays usable at phone widths</li>
      <li>Boxed lists, toasts, a preferences dialog and an about dialog</li>
      <li>Settings and window state persisted with GSettings</li>
    </ul>
  </description>

  <developer id="io.github.fwilhe2">
    <name>Florian Wilhelm</name>
  </developer>

  <launchable type="desktop-id">io.github.fwilhe2.NetworkingLab.desktop</launchable>

  <url type="homepage">https://github.com/fwilhe2/networking-lab</url>
  <url type="bugtracker">https://github.com/fwilhe2/networking-lab/issues</url>

  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/fwilhe2/networking-lab/main/data/screenshot-1.png</image>
      <caption>The main window</caption>
    </screenshot>
  </screenshots>

  <content_rating type="oars-1.1"/>

  <releases>
    <release version="0.1.0" date="2026-08-08">
      <description translate="no">
        <p>Initial release.</p>
      </description>
    </release>
  </releases>
</component>
